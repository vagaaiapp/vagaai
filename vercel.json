{
  "functions": {
    "api/send-alerts.js": { "maxDuration": 60 },
    "api/interview.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/onboarding/vaga/:step", "destination": "/onboarding/vaga/index.html" },
    { "source": "/onboarding/curriculo/:step", "destination": "/onboarding/curriculo/index.html" }
  ],
  "redirects": [
    { "source": "/lp-hero-preview", "destination": "/", "permanent": false },
    { "source": "/lp-hero-preview/:path*", "destination": "/", "permanent": false },
    { "source": "/lp-funis-preview", "destination": "/", "permanent": false },
    { "source": "/lp-funis-preview/:path*", "destination": "/", "permanent": false },
    { "source": "/lp-nova-aprovacao", "destination": "/", "permanent": false },
    { "source": "/lp-nova-aprovacao/:path*", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/index.template.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), payment=(self)" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), payment=(self)" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/send-alerts",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron-onboarding",
      "schedule": "0 12 * * *"
    }
  ]
}
